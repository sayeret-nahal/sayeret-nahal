# Supabase project (Settings → API). Publishable key only — the app never needs the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app (used in self-update links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: e-mail alert to the on-call staff when someone presses "I need to talk"
RESEND_API_KEY=
ALERT_EMAIL_FROM=crm@your-domain.org
ALERT_EMAIL_TO=oncall@your-domain.org

# --- Integrations (docs/09-integrations.md) ---
# Shared secret between the server and the database (≥32 chars). After setting it, open
# ניהול ← חיבורים and press "סנכרון המפתח" once.
INGEST_SECRET=
# Key in the webhook URLs (/api/hooks/<provider>?key=…). One for all, or per provider: HOOK_KEY_JGIVE, HOOK_KEY_GROW, HOOK_KEY_NEXUS, HOOK_KEY_019
HOOK_KEY=
# Optional: the webhookKey Grow assigns to your account (checked on every Grow webhook)
GROW_WEBHOOK_KEY=
# Broadcast sender (Vercel Cron sends it as "Authorization: Bearer …")
CRON_SECRET=
# 019 (docs.019sms.co.il): API token, verified WhatsApp business number (972…), SMS username and sender name
SMS019_TOKEN=
SMS019_WA_PHONE=
SMS019_USERNAME=
SMS019_SMS_SOURCE=
# Optional: opt-out line appended to SMS broadcasts
BROADCAST_SMS_FOOTER=
# The association's website(s) allowed to embed the inquiry form / call the inquiry API (comma separated)
WEBSITE_ORIGINS=
# Bot protection on public forms (Cloudflare Turnstile) — off until both are set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
